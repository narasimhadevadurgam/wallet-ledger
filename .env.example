# Copy to .env and adjust. .env is gitignored.

# Postgres connection string for the ledger database (required by migrate/api/worker).
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet_ledger

# HTTP port the API listens on.
PORT=3000

# LLM backend: "mock" (default, zero external deps) or "ollama".
LLM_PROVIDER=mock

# Ollama (OpenAI-compatible) settings, used only when LLM_PROVIDER=ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Cron schedule for the nightly reconciliation job (min hour dom mon dow).
RECON_CRON=0 2 * * *

# Bearer token guarding admin endpoints (reconciliation trigger, held-transfer release).
# Optional; if unset, admin endpoints follow their configured default policy.
ADMIN_TOKEN=

# How long completed idempotency keys are retained before cleanup (hours).
IDEMPOTENCY_CLEANUP_HOURS=24
